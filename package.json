{
	"name": "agentscope-web-ui",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev:frontend": "pnpm --filter frontend dev",
		"dev:backend": "python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000",
		"dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
		"build:frontend": "pnpm --filter frontend build",
		"build": "pnpm build:frontend",
		"format": "prettier --write . && pnpm --filter frontend lint:fix",
		"format:check": "prettier --check . && pnpm --filter frontend lint",
		"prepare": "husky"
	},
	"lint-staged": {
		"frontend/**/*.{ts,tsx}": [
			"prettier --write",
			"pnpm --dir frontend exec eslint --fix"
		],
		"*.{json,css,md,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"concurrently": "^8.2.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3"
	}
}
